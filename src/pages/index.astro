---
import "../styles/global.css";

const title = "Eduardo Bachmann — Full Stack Developer";
const description =
  "Eduardo Bachmann — Desarrollador backend construyendo microservicios, flujos agénticos con IA y arquitecturas cloud robustas.";

// Experiencia desde abril 2022 (se recalcula en el cliente)
const START = new Date(2022, 3, 1);
const yearsAtBuild = ((Date.now() - START.getTime()) / 31557600000).toFixed(1);

const LINKEDIN = "https://www.linkedin.com/in/eduardo-bachmann-20a275183/";
const GITHUB = "https://github.com/Frey-r";

const projects = [
  {
    name: "Tiny Tacticians",
    es: "Juego de tácticas por turnos dentro de Reddit: forjas un general que pelea como fantasma contra tu comunidad. Simulación determinista que el servidor re-ejecuta, así que no se puede hacer trampa.",
    en: "Turn-based tactics game that lives inside Reddit: forge a general that fights your community as a ghost. A deterministic simulation the server re-runs, so cheating is impossible.",
    tags: [{ es: "TypeScript" }, { es: "Phaser" }, { es: "Devvit" }, { es: "Redis" }],
    url: "https://github.com/Frey-r/Tiny-tacticians",
  },
  {
    name: "Elo Race",
    es: "Bot de Discord con API en FastAPI para competir subiendo Elo en League of Legends: registras tu invocador, te unes a carreras y sigues el leaderboard con datos de la API de Riot.",
    en: "Discord bot backed by a FastAPI service for League of Legends Elo races: register your summoner, join races and follow the leaderboard with Riot API data.",
    tags: [{ es: "Python" }, { es: "FastAPI" }, { es: "Discord" }, { es: "Riot API" }],
    url: "https://github.com/Frey-r/EloRace",
  },
];

const jobs = [
  {
    period: "2025 —",
    role: { es: "Backend Developer IA", en: "AI Backend Developer" },
    company: "ZeroQ",
    es: "flujos agénticos, multi-agentes y servidores MCP. Python, Go, AWS.",
    en: "agentic and multi-agent workflows, MCP servers. Python, Go, AWS.",
  },
  {
    period: "2022 — 2025",
    role: { es: "Desarrollador Backend", en: "Backend Developer" },
    company: "Idok",
    es: "microservicios de autenticación y firma digital (Java, Spring Boot) y reportería en AWS.",
    en: "auth and digital-signature microservices (Java, Spring Boot) plus AWS reporting pipeline.",
  },
  {
    period: "2023 — 2025",
    role: { es: "Desarrollador Frontend", en: "Frontend Developer" },
    company: "Archfee",
    es: "plataforma de costos de construcción para arquitectos en Ruby on Rails.",
    en: "construction-cost platform for architects, built on Ruby on Rails.",
  },
];

const stack = [
  { es: "IA & Agentes", en: "AI & Agents", tools: "Langchain · Langgraph · MCP" },
  { es: "Backend", en: "Backend", tools: "FastAPI · Go/Gin" },
  { es: "Datos", en: "Data", tools: "SQL · NoSQL · Vector" },
  { es: "Cloud & DevOps", en: "Cloud & DevOps", tools: "AWS · Docker" },
];

const chips = ["Python", "Go", "Vue", "Astro", "Lambda", "SQS"];
---

<!doctype html>
<html lang="es" data-theme="dark" data-lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="author" content="Eduardo Bachmann" />
    <meta name="color-scheme" content="dark light" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
    <script is:inline>
      (function () {
        var r = document.documentElement;
        try {
          var t = localStorage.getItem("eb-theme");
          var l = localStorage.getItem("eb-lang");
          if (t === "light" || t === "dark") r.dataset.theme = t;
          if (l === "es" || l === "en") r.dataset.lang = l;
        } catch (_) {}
        r.lang = r.dataset.lang;
      })();
    </script>
  </head>
  <body>
    <div class="page">
      <div class="blobs" aria-hidden="true">
        <div class="blob blob--1"></div>
        <div class="blob blob--2"></div>
        <div class="blob blob--3"></div>
      </div>

      <div class="wrap">
        <header class="header">
          <div class="brand">
            <span class="brand__name">Eduardo Bachmann</span>
            <span class="brand__role">Full Stack · Backend · IA</span>
          </div>
          <div class="toggles glass" data-glass>
            <button type="button" class="toggle" id="toggle-lang">
              <span data-l="es">EN</span><span data-l="en">ES</span>
            </button>
            <span class="toggles__sep" aria-hidden="true"></span>
            <button type="button" class="toggle" id="toggle-theme">
              <span class="only-dark"><span data-l="es">Claro</span><span data-l="en">Light</span></span>
              <span class="only-light"><span data-l="es">Oscuro</span><span data-l="en">Dark</span></span>
            </button>
          </div>
        </header>

        <main class="bento">
          <!-- Hero -->
          <section class="cell glass cell--hero span-8" data-glass>
            <div class="hero__copy">
              <h1 class="hero__title">
                <span data-l="es">Construyendo sistemas que piensan y escalan.</span>
                <span data-l="en">Building systems that think and scale.</span>
              </h1>
              <p class="hero__lead">
                <span data-l="es">Desarrollador backend construyendo microservicios, flujos agénticos con IA y arquitecturas cloud robustas.</span>
                <span data-l="en">Backend developer building microservices, agentic AI workflows and robust cloud architecture.</span>
              </p>
            </div>
            <div class="actions">
              <a href={GITHUB} target="_blank" rel="noopener noreferrer" class="btn btn--solid">
                <span data-l="es">Ver GitHub</span><span data-l="en">View GitHub</span>
              </a>
              <a href={LINKEDIN} target="_blank" rel="noopener noreferrer" class="btn btn--ghost">LinkedIn</a>
            </div>
          </section>

          <!-- Foto -->
          <section class="cell glass cell--photo span-4" data-glass>
            <img src="/profile.webp" alt="Eduardo Bachmann" class="photo__img" />
            <div class="photo__shade" aria-hidden="true"></div>
            <div class="photo__caption">
              <span class="photo__name">Eduardo Bachmann</span>
              <span class="photo__place">Santiago, Chile</span>
            </div>
          </section>

          <!-- Experiencia -->
          <section class="cell glass cell--stat span-3" data-glass>
            <span class="label"><span data-l="es">Experiencia</span><span data-l="en">Experience</span></span>
            <div class="stat">
              <span class="stat__big" id="years">{yearsAtBuild}</span>
              <span class="stat__sub">
                <span data-l="es">años profesionales · desde abril 2022</span>
                <span data-l="en">professional years · since April 2022</span>
              </span>
            </div>
          </section>

          <!-- Hora local -->
          <section class="cell glass cell--stat span-3" data-glass>
            <span class="label"><span data-l="es">Hora local</span><span data-l="en">Local time</span></span>
            <div class="stat">
              <span class="stat__clock mono" id="clock">--:--</span>
              <span class="stat__sub">Chile · <span id="date-text"></span></span>
            </div>
          </section>

          <!-- Disponibilidad -->
          <section class="cell glass cell--stat span-3" data-glass>
            <span class="label"><span data-l="es">Estado</span><span data-l="en">Status</span></span>
            <div class="stat stat--status">
              <span class="status">
                <span class="bars" aria-hidden="true"><span></span><span></span><span></span></span>
                <span data-l="es">Disponible</span><span data-l="en">Available</span>
              </span>
              <span class="stat__sub">
                <span data-l="es">Aceptando nuevos proyectos</span>
                <span data-l="en">Taking on new projects</span>
              </span>
            </div>
          </section>

          <!-- Último push -->
          <section class="cell glass cell--stat span-3" data-glass>
            <span class="label"><span data-l="es">Último push</span><span data-l="en">Latest push</span></span>
            <div class="stat stat--push">
              <a href={`${GITHUB}?tab=repositories`} target="_blank" rel="noopener noreferrer" class="push__repo mono" id="push-repo">
                <span data-l="es">cargando…</span><span data-l="en">loading…</span>
              </a>
              <span class="stat__sub" id="push-when">
                <span data-l="es">consultando GitHub</span><span data-l="en">querying GitHub</span>
              </span>
            </div>
          </section>

          <!-- Proyectos -->
          {
            projects.map((p) => (
              <section class="cell glass cell--project span-6" data-glass>
                <h2 class="project__title">{p.name}</h2>
                <p class="project__desc">
                  <span data-l="es">{p.es}</span>
                  <span data-l="en">{p.en}</span>
                </p>
                <div class="project__foot">
                  {p.tags.map((t) => (
                    <span class="pill mono">
                      {t.en ? (
                        <>
                          <span data-l="es">{t.es}</span>
                          <span data-l="en">{t.en}</span>
                        </>
                      ) : (
                        t.es
                      )}
                    </span>
                  ))}
                  <a href={p.url} target="_blank" rel="noopener noreferrer" class="project__link">
                    Source →
                  </a>
                </div>
              </section>
            ))
          }

          <!-- Trayectoria -->
          <section class="cell glass cell--list span-7" data-glass>
            <h2 class="cell__title"><span data-l="es">Trayectoria</span><span data-l="en">Track record</span></h2>
            <div class="timeline">
              {
                jobs.map((j, i) => (
                  <>
                    {i > 0 && <div class="rule" />}
                    <div class="job">
                      <span class="job__period mono">{j.period}</span>
                      <div class="job__body">
                        <span class="job__role">
                          <span data-l="es">{j.role.es}</span>
                          <span data-l="en">{j.role.en}</span>
                        </span>
                        <span class="job__desc">
                          {j.company} — <span data-l="es">{j.es}</span>
                          <span data-l="en">{j.en}</span>
                        </span>
                      </div>
                    </div>
                  </>
                ))
              }
            </div>
          </section>

          <!-- Stack -->
          <section class="cell glass cell--list span-5" data-glass>
            <h2 class="cell__title">Stack</h2>
            <div class="stack">
              {
                stack.map((s, i) => (
                  <>
                    {i > 0 && <div class="rule" />}
                    <div class="stack__row">
                      <span class="stack__name">
                        {s.es === s.en ? (
                          s.es
                        ) : (
                          <>
                            <span data-l="es">{s.es}</span>
                            <span data-l="en">{s.en}</span>
                          </>
                        )}
                      </span>
                      <span class="stack__tools mono">{s.tools}</span>
                    </div>
                  </>
                ))
              }
            </div>
            <div class="chips">
              {chips.map((c) => <span class="chip mono">{c}</span>)}
            </div>
          </section>

          <!-- Contacto -->
          <section class="cell glass cell--contact span-12" data-glass id="contacto">
            <div class="contact__copy">
              <h2 class="contact__title">
                <span data-l="es">¿Construimos algo?</span><span data-l="en">Let's build something.</span>
              </h2>
              <span class="contact__sub">
                <span data-l="es">Respondo en menos de 24 horas.</span><span data-l="en">I reply within 24 hours.</span>
              </span>
            </div>
            <div class="actions">
              <a href="mailto:eduardo@ebachmann.dev" class="btn btn--solid btn--lg">
                <span data-l="es">Contáctame</span><span data-l="en">Get in touch</span>
              </a>
              <a href={LINKEDIN} target="_blank" rel="noopener noreferrer" class="btn btn--ghost btn--lg">LinkedIn</a>
              <a href={GITHUB} target="_blank" rel="noopener noreferrer" class="btn btn--ghost btn--lg">GitHub</a>
            </div>
          </section>
        </main>

        <footer class="footer">
          <span>© {new Date().getFullYear()} Eduardo Bachmann</span>
          <span><span data-l="es">Diseñado para perdurar</span><span data-l="en">Designed to endure</span></span>
        </footer>
      </div>
    </div>

    <script>
      const root = document.documentElement;
      const START = new Date(2022, 3, 1).getTime();
      const TZ = "America/Santiago";

      const isEs = () => root.dataset.lang !== "en";
      const store = (k: string, v: string) => {
        try {
          localStorage.setItem(k, v);
        } catch (_) {}
      };

      // ── Toggles ──
      document.getElementById("toggle-lang")?.addEventListener("click", () => {
        root.dataset.lang = isEs() ? "en" : "es";
        root.lang = root.dataset.lang;
        store("eb-lang", root.dataset.lang);
        tick();
        renderPush();
      });
      document.getElementById("toggle-theme")?.addEventListener("click", () => {
        root.dataset.theme = root.dataset.theme === "light" ? "dark" : "light";
        store("eb-theme", root.dataset.theme);
      });

      // ── Reloj y experiencia ──
      const clockEl = document.getElementById("clock");
      const dateEl = document.getElementById("date-text");
      const yearsEl = document.getElementById("years");
      function tick() {
        const now = new Date();
        const loc = isEs() ? "es-CL" : "en-US";
        if (clockEl)
          clockEl.textContent = now.toLocaleTimeString(loc, {
            timeZone: TZ,
            hour: "2-digit",
            minute: "2-digit",
            hour12: false,
          });
        if (dateEl)
          dateEl.textContent = now.toLocaleDateString(loc, { timeZone: TZ, day: "2-digit", month: "short" });
        if (yearsEl) yearsEl.textContent = ((now.getTime() - START) / 31557600000).toFixed(1);
      }
      tick();
      setInterval(tick, 1000);

      // ── Último push ──
      type Push = { repo: string; full: string; at: Date } | { failed: true } | null;
      let push: Push = null;
      const repoEl = document.getElementById("push-repo") as HTMLAnchorElement | null;
      const whenEl = document.getElementById("push-when");

      function ago(d: Date) {
        const es = isEs();
        const m = Math.max(0, Math.floor((Date.now() - d.getTime()) / 60000));
        if (m < 60) return es ? `hace ${m} min` : `${m} min ago`;
        const h = Math.floor(m / 60);
        if (h < 24) return es ? `hace ${h} h` : `${h} h ago`;
        const dd = Math.floor(h / 24);
        return es ? `hace ${dd} d` : `${dd} d ago`;
      }

      function renderPush() {
        if (!push || !repoEl || !whenEl) return;
        if ("failed" in push) {
          repoEl.textContent = "github.com/Frey-r";
          whenEl.textContent = isEs() ? "ver actividad reciente" : "see recent activity";
          return;
        }
        repoEl.textContent = push.repo;
        repoEl.href = `https://github.com/${push.full}`;
        whenEl.textContent = ago(push.at);
      }

      async function getJson(url: string) {
        const r = await fetch(url);
        if (!r.ok) throw new Error(String(r.status));
        return r.json();
      }

      async function loadPush() {
        // 1) Backend propio (con token, sin rate limit del navegador)
        try {
          const d = await getJson("/api-portfolio/github/last-push");
          if (d && d.repo && d.pushed_at) {
            const full = String(d.repo);
            push = { repo: full.split("/").pop() || full, full, at: new Date(d.pushed_at) };
            return renderPush();
          }
        } catch (_) {}
        // 2) API pública de GitHub: eventos
        try {
          const evts = await getJson("https://api.github.com/users/Frey-r/events/public");
          const e = Array.isArray(evts) ? evts.find((x: any) => x.type === "PushEvent") || evts[0] : null;
          if (e) {
            push = { repo: e.repo.name.split("/")[1], full: e.repo.name, at: new Date(e.created_at) };
            return renderPush();
          }
        } catch (_) {}
        // 3) Repos ordenados por push
        try {
          const repos = await getJson("https://api.github.com/users/Frey-r/repos?sort=pushed&per_page=1");
          const rp = Array.isArray(repos) ? repos[0] : null;
          if (rp) {
            push = { repo: rp.name, full: rp.full_name, at: new Date(rp.pushed_at) };
            return renderPush();
          }
        } catch (_) {}
        push = { failed: true };
        renderPush();
      }
      loadPush();
      setInterval(renderPush, 60000);
    </script>
  </body>
</html>
